{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AgilityShift",
          "informationUri": "https://github.com/Benadic90/agilityshift",
          "rules": [
            {
              "id": "PY_CRYPTO_LIMIT_CONSTANT",
              "name": "Hardcoded cryptographic size constant",
              "shortDescription": {
                "text": "Hardcoded cryptographic size constant"
              },
              "fullDescription": {
                "text": "Hardcoded constants for crypto sizes will break during PQC migration."
              },
              "help": {
                "text": "Review this code, database field, or API contract against the target PQC migration profile."
              }
            },
            {
              "id": "PY_CRYPTO_TRUNCATION_LIMIT",
              "name": "Possible crypto material truncation",
              "shortDescription": {
                "text": "Possible crypto material truncation"
              },
              "fullDescription": {
                "text": "Truncating crypto material will silently destroy PQC keys and signatures."
              },
              "help": {
                "text": "Review this code, database field, or API contract against the target PQC migration profile."
              }
            },
            {
              "id": "PY_CRYPTO_LENGTH_LIMIT",
              "name": "Hardcoded crypto length validation",
              "shortDescription": {
                "text": "Hardcoded crypto length validation"
              },
              "fullDescription": {
                "text": "Hardcoded length checks will fail when PQC keys and signatures are introduced."
              },
              "help": {
                "text": "Review this code, database field, or API contract against the target PQC migration profile."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "PY_CRYPTO_LIMIT_CONSTANT",
          "level": "error",
          "message": {
            "text": "Hardcoded cryptographic size constant ML-DSA-65 requires 3309 bytes, which is 6.46x larger than the current 512 bytes/chars limit. This is a high migration breakage risk. Suggested fix: Review this code, database field, or API contract against the target PQC migration profile."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "test.py"
                },
                "region": {
                  "startLine": 6
                }
              }
            }
          ]
        },
        {
          "ruleId": "PY_CRYPTO_TRUNCATION_LIMIT",
          "level": "error",
          "message": {
            "text": "Possible crypto material truncation ML-DSA-65 requires 3309 bytes, which is 12.93x larger than the current 256 chars/bytes limit. This may break during PQC migration. Suggested fix: Review this code, database field, or API contract against the target PQC migration profile."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "test.py"
                },
                "region": {
                  "startLine": 10
                }
              }
            }
          ]
        },
        {
          "ruleId": "PY_CRYPTO_LENGTH_LIMIT",
          "level": "error",
          "message": {
            "text": "Hardcoded crypto length validation ML-DSA-65 requires 3309 bytes, which is 12.93x larger than the current 256 chars/bytes limit. This may break during PQC migration. Suggested fix: Review this code, database field, or API contract against the target PQC migration profile."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "test.py"
                },
                "region": {
                  "startLine": 13
                }
              }
            }
