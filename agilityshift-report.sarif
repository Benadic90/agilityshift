        },
        {
          "ruleId": "PY_CRYPTO_LENGTH_LIMIT",
          "level": "error",
          "message": {
            "text": "Hardcoded crypto length validation ML-DSA-65 requires 3309 bytes, which is 3.23x larger than the current 1024 chars/bytes limit. This is a high migration breakage risk. Suggested fix: Review this code, database field, or API contract against the target PQC migration profile."
          },
          "locations": [
